    "payload": {
      "arguments": {
        "content": "package text;\n\nimport java.util.Collections;\nimport java.util.LinkedHashMap;\nimport java.util.Locale;\nimport java.util.Map;\n\npublic final class Header {\n    private Header() {\n    }\n\n    public static Map<String, String> parse(String line) {\n        if (line == null) {\n            throw new IllegalArgumentException(\"line must not be null\");\n        }\n        if (line.indexOf('\\r') >= 0 || line.indexOf('\\n') >= 0) {\n            throw new IllegalArgumentException(\"line must not contain CR/LF\");\n        }\n        int colon = line.indexOf(':');\n        if (colon < 0) {\n            throw new IllegalArgumentException(\"line must contain a colon\");\n        }\n        String name = line.substring(0, colon).trim().toLowerCase(Locale.ROOT);\n        if (!name.matches(\"[a-z][a-z0-9-]*\")) {\n            throw new IllegalArgumentException(\"invalid header name\");\n        }\n        String value = line.substring(colon + 1).trim();\n        Map<String, String> result = new LinkedHashMap<>(1);\n        result.put(name, value);\n        return Collections.unmodifiableMap(result);\n    }\n}\n",
        "path": "src/text/Header.java"
      },
      "call_id": "call_QRh1LqRgYJIt63dRfAG6hsvr",
      "name": "write_file"
    },
