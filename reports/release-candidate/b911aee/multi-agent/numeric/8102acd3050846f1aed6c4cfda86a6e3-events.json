    "type": "tool_prepared",
    "payload": {
      "arguments": {
        "content": "package retry;\n\npublic final class Delay {\n  private Delay() {}\n\n  public static long millis(long base, int attempt, long cap) {\n    if (base < 1 || attempt < 0 || cap < base) {\n      throw new IllegalArgumentException();\n    }\n    long value = base;\n    int shifts = attempt;\n    while (shifts > 0 && value < cap) {\n      if (value > (Long.MAX_VALUE >> 1)) {\n        return cap;\n      }\n      value <<= 1;\n      if (value >= cap) {\n        return cap;\n      }\n      shifts--;\n    }\n    return Math.min(value, cap);\n  }\n}\n",
        "path": "src/retry/Delay.java"
      },
      "call_id": "call_TIBLXHwdfC8Et7RdghTliHX7",
      "name": "write_file"
    },
