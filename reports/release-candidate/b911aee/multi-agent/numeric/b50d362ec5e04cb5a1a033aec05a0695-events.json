    "task_id": "b50d362ec5e04cb5a1a033aec05a0695",
    "sequence": 18,
    "type": "tool_prepared",
    "payload": {
      "arguments": {
        "content": "package stats;\n\nimport java.math.BigInteger;\n\npublic final class Mean {\n    public static long rounded(long[] values) {\n        if (values == null || values.length == 0) {\n            throw new IllegalArgumentException();\n        }\n\n        BigInteger sum = BigInteger.ZERO;\n        for (long v : values) {\n            sum = sum.add(BigInteger.valueOf(v));\n        }\n\n        BigInteger[] divRem = sum.divideAndRemainder(BigInteger.valueOf(values.length));\n        BigInteger quotient = divRem[0];\n        BigInteger remainder = divRem[1];\n\n        if (remainder.signum() != 0) {\n            BigInteger absRem2 = remainder.abs().shiftLeft(1);\n            BigInteger absDen = BigInteger.valueOf(values.length).abs();\n            int cmp = absRem2.compareTo(absDen);\n            if (cmp > 0 || (cmp == 0 && quotient.testBit(0))) {\n                quotient = quotient.add(BigInteger.valueOf(remainder.signum()));\n            }\n        }\n\n        if (quotient.compareTo(BigInteger.valueOf(Long.MAX_VALUE)) > 0\n                || quotient.compareTo(BigInteger.valueOf(Long.MIN_VALUE)) < 0) {\n            throw new IllegalArgumentException();\n        }\n        return quotient.longValue();\n    }\n}\n",
        "path": "src/stats/Mean.java"
      },
      "call_id": "call_n2v8DuRIJ8h0FcZrSnCknpbh",
      "name": "write_file"
    },
    "created_at": 1790489275.6435597
