    "sequence": 15,
    "type": "tool_prepared",
    "payload": {
      "arguments": {
        "content": "package checkout.shipping;\n\nimport java.util.Locale;\n\npublic final class ShippingQuote {\n    public static int quoteCents(int weightGrams, String postalCode) {\n        if (weightGrams <= 0) {\n            throw new IllegalArgumentException(\"weightGrams must be positive\");\n        }\n        if (postalCode == null) {\n            throw new IllegalArgumentException(\"postalCode must be non-blank\");\n        }\n\n        String normalized = postalCode.trim().toUpperCase(Locale.ROOT);\n        if (normalized.isEmpty()) {\n            throw new IllegalArgumentException(\"postalCode must be non-blank\");\n        }\n\n        long baseCents;\n        long perStarted500;\n        if (normalized.startsWith(\"AU\")) {\n            baseCents = 450L;\n            perStarted500 = 120L;\n        } else if (normalized.startsWith(\"NZ\")) {\n            baseCents = 850L;\n            perStarted500 = 210L;\n        } else if (normalized.startsWith(\"INTL\")) {\n            baseCents = 1800L;\n            perStarted500 = 450L;\n        } else {\n            throw new IllegalArgumentException(\"unsupported postal code prefix\");\n        }\n\n        long units = ((long) weightGrams + 499L) / 500L;\n        long total = baseCents + perStarted500 * units;\n        if (total > Integer.MAX_VALUE) {\n            throw new ArithmeticException(\"total exceeds int range\");\n        }\n        return (int) total;\n    }\n}\n",
        "path": "src/checkout/shipping/ShippingQuote.java"
      },
      "call_id": "call_HrvXMgffqmWKXntW0QW9BCLs",
      "name": "write_file"
