    "sequence": 14,
    "type": "tool_prepared",
    "payload": {
      "arguments": {
        "content": "package retry;\n\npublic final class Delay {\n  public static long millis(long base, int attempt, long cap) {\n    if (base < 1 || attempt < 0 || cap < base) {\n      throw new IllegalArgumentException();\n    }\n\n    long value = base;\n    int remaining = attempt;\n    while (remaining > 0 && value < cap) {\n      int step = Integer.numberOfTrailingZeros(remaining);\n      if (step > 0) {\n        long factor = 1L << step;\n        if (value > cap / factor) {\n          return cap;\n        }\n        value *= factor;\n        remaining -= step;\n        if (value >= cap) {\n          return cap;\n        }\n      } else {\n        if (value > cap / 2) {\n          return cap;\n        }\n        value <<= 1;\n        remaining--;\n      }\n    }\n    return Math.min(cap, value);\n  }\n}\n",
        "path": "src/retry/Delay.java"
      },
      "call_id": "call_pNYmQQ95CJtN6ojt7e6etWps",
      "name": "write_file"
    },
    "created_at": 1790490991.540628
