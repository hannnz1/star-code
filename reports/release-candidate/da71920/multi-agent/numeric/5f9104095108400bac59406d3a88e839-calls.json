    "arguments": {
      "new_text": "package stats;\n\nimport java.math.BigDecimal;\nimport java.math.BigInteger;\nimport java.math.RoundingMode;\n\npublic final class Mean {\n    private Mean() {\n    }\n\n    public static long rounded(long[] values) {\n        if (values == null || values.length == 0) {\n            throw new IllegalArgumentException(\"values must not be null or empty\");\n        }\n\n        BigInteger sum = BigInteger.ZERO;\n        for (long value : values) {\n            sum = sum.add(BigInteger.valueOf(value));\n        }\n\n        BigDecimal mean = new BigDecimal(sum).divide(BigDecimal.valueOf(values.length), 0, RoundingMode.HALF_EVEN);\n        return mean.longValueExact();\n    }\n}\n",
