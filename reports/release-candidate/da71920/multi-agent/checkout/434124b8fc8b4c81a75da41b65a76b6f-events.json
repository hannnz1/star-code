    "type": "tool_prepared",
    "payload": {
      "arguments": {
        "content": "package checkout.pricing;\n\nimport java.math.BigDecimal;\nimport java.math.RoundingMode;\n\npublic final class DiscountPolicy {\n    private static final BigDecimal MEMBER_DISCOUNT = new BigDecimal(\"0.07\");\n    private static final BigDecimal BULK_DISCOUNT = new BigDecimal(\"0.05\");\n\n    public static int totalCents(int unitCents, int quantity, boolean member) {\n        if (unitCents < 0 || quantity < 0) {\n            throw new IllegalArgumentException(\"unitCents and quantity must be non-negative\");\n        }\n        if (quantity == 0) {\n            return 0;\n        }\n\n        BigDecimal subtotal = BigDecimal.valueOf(unitCents).multiply(BigDecimal.valueOf(quantity));\n        BigDecimal discountRate = BigDecimal.ZERO;\n        if (member) {\n            discountRate = discountRate.add(MEMBER_DISCOUNT);\n        }\n        if (quantity >= 12) {\n            discountRate = discountRate.add(BULK_DISCOUNT);\n        }\n\n        BigDecimal total = subtotal.multiply(BigDecimal.ONE.subtract(discountRate));\n        BigDecimal rounded = total.setScale(0, RoundingMode.HALF_EVEN);\n        try {\n            return rounded.intValueExact();\n        } catch (ArithmeticException ex) {\n            throw new IllegalArgumentException(\"total exceeds Integer.MAX_VALUE\", ex);\n        }\n    }\n}\n",
        "path": "src/checkout/pricing/DiscountPolicy.java"
      },
