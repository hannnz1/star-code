    "type": "tool_prepared",
    "payload": {
      "arguments": {
        "content": "package checkout.shipping;\n\nimport java.util.Locale;\n\npublic final class ShippingQuote {\n    public static int quoteCents(int weightGrams, String postalCode) {\n        if (weightGrams <= 0) {\n            throw new IllegalArgumentException(\"weightGrams must be positive\");\n        }\n        if (postalCode == null) {\n            throw new IllegalArgumentException(\"postalCode must be non-blank\");\n        }\n\n        String normalized = postalCode.trim().toUpperCase(Locale.ROOT);\n        if (normalized.isEmpty()) {\n            throw new IllegalArgumentException(\"postalCode must be non-blank\");\n        }\n\n        long base;\n        long perBlock;\n        if (normalized.startsWith(\"AU\")) {\n            base = 450L;\n            perBlock = 120L;\n        } else if (normalized.startsWith(\"NZ\")) {\n            base = 850L;\n            perBlock = 210L;\n        } else if (normalized.startsWith(\"INTL\")) {\n            base = 1800L;\n            perBlock = 450L;\n        } else {\n            throw new IllegalArgumentException(\"Unsupported postal code prefix\");\n        }\n\n        long blocks = (weightGrams + 499L) / 500L;\n        long total = base + perBlock * blocks;\n        if (total > Integer.MAX_VALUE) {\n            throw new ArithmeticException(\"total exceeds Integer.MAX_VALUE\");\n        }\n        return (int) total;\n    }\n}\n",
        "path": "src/checkout/shipping/ShippingQuote.java"
      },
      "call_id": "call_g9rsfDcC44o6GZp1MxGbTqQU",
      "name": "write_file"
    },
    "created_at": 1790490970.9750009
