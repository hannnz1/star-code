    "sequence": 14,
    "type": "tool_prepared",
    "payload": {
      "arguments": {
        "content": "package checkout.shipping;\n\nimport java.util.Locale;\n\npublic final class ShippingQuote {\n    public static int quoteCents(int weightGrams, String postalCode) {\n        if (weightGrams <= 0) {\n            throw new IllegalArgumentException(\"weightGrams must be positive\");\n        }\n        if (postalCode == null) {\n            throw new IllegalArgumentException(\"postalCode must not be blank\");\n        }\n\n        String normalized = postalCode.trim().toUpperCase(Locale.ROOT);\n        if (normalized.isEmpty()) {\n            throw new IllegalArgumentException(\"postalCode must not be blank\");\n        }\n\n        long startedUnits = (weightGrams + 499L) / 500L;\n        long base;\n        long perUnit;\n\n        if (normalized.startsWith(\"AU\")) {\n            base = 450L;\n            perUnit = 120L;\n        } else if (normalized.startsWith(\"NZ\")) {\n            base = 850L;\n            perUnit = 210L;\n        } else if (normalized.startsWith(\"INTL\")) {\n            base = 1800L;\n            perUnit = 450L;\n        } else {\n            throw new IllegalArgumentException(\"unsupported postal code prefix\");\n        }\n\n        long total = base + perUnit * startedUnits;\n        if (total > Integer.MAX_VALUE) {\n            throw new ArithmeticException(\"quote exceeds integer range\");\n        }\n        return (int) total;\n    }\n}\n",
        "path": "src/checkout/shipping/ShippingQuote.java"
      },
      "call_id": "call_MOUWhuB3piMk2digm89qY4Tw",
      "name": "write_file"
    },
