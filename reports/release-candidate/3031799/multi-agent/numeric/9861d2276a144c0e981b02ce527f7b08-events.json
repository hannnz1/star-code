    "payload": {
      "arguments": {
        "content": "package retry;\n\npublic final class Delay {\n    private Delay() {\n    }\n\n    public static long millis(long base, int attempt, long cap) {\n        if (base < 1L || attempt < 0 || cap < base) {\n            throw new IllegalArgumentException();\n        }\n\n        long value = base;\n        for (int i = 0; i < attempt; i++) {\n            if (value >= cap) {\n                return cap;\n            }\n            if (value > (Long.MAX_VALUE >> 1)) {\n                return cap;\n            }\n            value <<= 1;\n        }\n        return value > cap ? cap : value;\n    }\n}\n",
        "path": "src/retry/Delay.java"
      },
      "call_id": "call_hf2CSh6OPARWt0MvhzbUJlDo",
      "name": "write_file"
