    "sequence": 18,
    "type": "tool_prepared",
    "payload": {
      "arguments": {
        "content": "package stats;\n\nimport java.math.BigInteger;\n\npublic final class Mean {\n    private Mean() {\n    }\n\n    public static long rounded(long[] values) {\n        if (values == null || values.length == 0) {\n            throw new IllegalArgumentException();\n        }\n        BigInteger sum = BigInteger.ZERO;\n        for (long value : values) {\n            sum = sum.add(BigInteger.valueOf(value));\n        }\n        BigInteger len = BigInteger.valueOf(values.length);\n        BigInteger[] divRem = sum.divideAndRemainder(len);\n        BigInteger quotient = divRem[0];\n        BigInteger remainder = divRem[1];\n        BigInteger absRem2 = remainder.abs().shiftLeft(1);\n        int cmp = absRem2.compareTo(len);\n        if (cmp > 0 || (cmp == 0 && quotient.testBit(0))) {\n            quotient = quotient.add(BigInteger.valueOf(sum.signum() >= 0 ? 1 : -1));\n        }\n        return quotient.longValueExact();\n    }\n}\n",
        "path": "src/stats/Mean.java"
      },
      "call_id": "call_RnrJH7lVbaBpfrCeuIm21p14",
      "name": "write_file"
    },
    "created_at": 1790488785.661017
